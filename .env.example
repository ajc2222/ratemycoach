# ---------------------------------------------------------------------------
# PrepCoach Reviews — environment
# Copy to `.env.local` for development. Never commit a real .env file.
# The app runs with ALL of these unset (local JSON database, admin disabled).
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Unset  -> local append-only JSON driver at .data/   (development default)
# Set    -> PostgreSQL / Supabase                      (production)
# Supabase: Project Settings -> Database -> Connection string -> URI (pooled, port 6543)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Force SSL behaviour if auto-detection is wrong: "require" | "disable"
# DATABASE_SSL=require

# --- Administrator access -------------------------------------------------
# Both must be set or /admin returns 503 (disabled). Use a long random password.
# ADMIN_USER=operator
# ADMIN_PASSWORD=change-me-to-something-long-and-random

# --- Experiment -----------------------------------------------------------
# Changing this re-buckets every visitor. Set once, before launch, then leave it.
# EXPERIMENT_SALT=prepcoach-2026-launch

# --- Privacy --------------------------------------------------------------
# Salt for hashing IPs used in rate limiting. Raw IPs are never stored.
# Unset -> a random salt is generated per process (rate limits reset on restart).
# IP_HASH_SALT=another-long-random-string

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# CONTACT_EMAIL=hello@prepcoachreviews.com

# --- Optional analytics sink (privacy-conscious, cookie-less) --------------
# PLAUSIBLE_DOMAIN=prepcoachreviews.com
# PLAUSIBLE_HOST=https://plausible.io

# --- Optional error monitoring -------------------------------------------
# SENTRY_DSN=

# --- Debugging ------------------------------------------------------------
# NEXT_PUBLIC_ANALYTICS_DEBUG=true
